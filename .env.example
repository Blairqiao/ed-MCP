# Create an Ed API token in your account settings.
ED_API_TOKEN=
# Use your Ed region, such as us or au.
ED_REGION=us
# Override the regional API base URL if needed.
# ED_API_BASE_URL=
# Store alert state in this directory.
# ED_STATE_DIR=~/.ed-mcp
# Hide tools that modify your Ed account.
# ED_READ_ONLY=1
